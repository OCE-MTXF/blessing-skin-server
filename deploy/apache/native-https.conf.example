# Apache 2.4 + Linux PHP 8.6 FPM, direct TLS; render paths/hostname for your site.
# This template is not automatically enabled. Load mod_ssl, mod_rewrite, mod_headers,
# mod_setenvif, mod_proxy, mod_proxy_fcgi, mod_mime and mod_authz_core. Restrict the
# backend Unix socket to Apache; there is no PHP listener on a network interface.
<VirtualHost *:443>
    ServerName skin.example.test
    DocumentRoot /srv/blessing/current/public
    SSLEngine on
    SSLProtocol -all +TLSv1.2 +TLSv1.3
    SSLCertificateFile /etc/ssl/blessing/fullchain.pem
    SSLCertificateKeyFile /etc/ssl/blessing/privkey.pem
    AllowEncodedSlashes Off
    LimitRequestBody 8388608
    TraceEnable Off
    # Do not record the request path, query, referrer, cookies, or headers.
    CustomLog /var/log/apache2/blessing-access.log "%m %>s %D"

    <Directory /srv/blessing/current/public>
        Options -Indexes -MultiViews +SymLinksIfOwnerMatch
        AllowOverride None
        Require all granted
        DirectoryIndex disabled

        RewriteEngine On
        RewriteCond %{HTTP_HOST} !^skin\.example\.test(?::443)?$ [NC]
        RewriteRule ^ - [R=421,END]
        RewriteRule ^(?:setup|admin/update|plugins|lang|storage)(?:/|$) - [R=404,END,NC]
        RewriteRule ^\.well-known/change-password$ index.php [END]
        RewriteRule (^|/)\. - [R=404,END]
        RewriteCond %{REQUEST_FILENAME} -f
        RewriteRule ^app/(?:[A-Za-z0-9_-][A-Za-z0-9_.-]*/)*[A-Za-z0-9_-][A-Za-z0-9_.-]*\.(?:js|css|woff2?|ttf|eot|ico|png|webp|svg|wasm|jpe?g|gif|avif|js\.LICENSE\.txt)$ - [END]
        RewriteRule ^app(?:/|$) - [R=404,END,NC]
        RewriteRule ^index\.php$ - [END]
        RewriteRule ^ index.php [END]

        <FilesMatch "^index\.php$">
            SetHandler "proxy:unix:/run/php/blessing-8.6.sock|fcgi://localhost/"
        </FilesMatch>
        CGIPassAuth On
        Header always set X-Content-Type-Options nosniff
        AddType application/wasm .wasm
    </Directory>
</VirtualHost>
