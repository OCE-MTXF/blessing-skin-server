{
  "compilerOptions": {
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./resources/assets/src/*"]
    },
    "resolveJsonModule": true,
    "esModuleInterop": true
  },
  "include": ["resources/assets/src", "tools", "webpack.config.ts"]
}
