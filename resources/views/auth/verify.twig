{% extends 'auth.base' %}

{% block title %}{{ trans('auth.verify.title') }}{% endblock %}

{% block content %}
  <p class="login-box-msg">{{ trans('Confirm this email address for your account.') }}</p>
  <form method="post">
    {{ csrf_field() }}
    <button type="submit" class="btn btn-primary btn-block">{{ trans('general.submit') }}</button>
  </form>
{% endblock %}
