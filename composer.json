{
  "name": "bs-community/blessing-skin-server",
  "description": "A web application brings your custom skins back in offline Minecraft servers.",
  "license": "MIT",
  "require": {
    "php": "~8.6.0",
    "ext-ctype": "*",
    "ext-curl": "*",
    "ext-dom": "*",
    "ext-fileinfo": "*",
    "ext-gd": "*",
    "ext-intl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-pdo": "*",
    "ext-session": "*",
    "ext-sodium": "*",
    "ext-tokenizer": "*",
    "ext-xml": "*",
    "composer/semver": "^3.4",
    "gregwar/captcha": "^2.1.1",
    "guzzlehttp/psr7": "^3.6",
    "laravel/framework": "^13.44.1",
    "laravel/passport": "^13.12",
    "league/commonmark": "^2.10.8",
    "nesbot/carbon": "^3.8",
    "rcrowe/twigbridge": "^0.14.8",
    "spatie/laravel-translation-loader": "^2.8.3",
    "symfony/process": "^8.1",
    "symfony/yaml": "^8.1",
    "twig/twig": "^3.31.1"
  },
  "require-dev": {
    "fakerphp/faker": "^1.24",
    "laravel/browser-kit-testing": "^7.3",
    "mockery/mockery": "^1.6",
    "phpunit/phpunit": "^13.4",
    "symfony/css-selector": "^8.1",
    "symfony/dom-crawler": "^8.1"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Blessing\\": "app/Compatibility/Blessing/",
      "Database\\Factories\\": "database/factories/"
    },
    "files": [
      "app/helpers.php"
    ]
  },
  "autoload-dev": {
    "classmap": ["tests/"]
  },
  "scripts": {
    "test": "phpunit",
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover"
    ]
  },
  "config": {
    "allow-plugins": {"php-http/discovery": false},
    "optimize-autoloader": true,
    "platform-check": true,
    "preferred-install": "dist",
    "sort-packages": true
  }
}
