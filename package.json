{
  "name": "blessing-skin-server",
  "version": "6.0.4",
  "description": "A web application brings your custom skins back in offline Minecraft servers.",
  "repository": {
    "type": "git",
    "url": "https://github.com/bs-community/blessing-skin-server"
  },
  "author": "printempw",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "webpack --mode development --watch",
    "build": "webpack --mode production",
    "lint": "eslint resources/assets/src resources/assets/tests tools webpack.config.ts",
    "fmt": "prettier --write resources/assets tools webpack.config.ts",
    "fmt:check": "prettier --check resources/assets tools webpack.config.ts",
    "type:check": "tsc -p . --noEmit && tsc -p ./resources/assets/tests --noEmit",
    "test": "jest",
    "build:urls": "node tools/generateUrls.ts"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@fortawesome/fontawesome-free": "6.7.2",
    "@tweenjs/tween.js": "25.0.0",
    "bootstrap": "4.6.2",
    "clsx": "2.1.1",
    "dompurify": "3.5.0",
    "echarts": "6.1.0",
    "immer": "11.2.10",
    "jquery": "3.8.0",
    "react": "18.3.1",
    "react-autosuggest": "10.1.0",
    "react-dom": "18.3.1",
    "react-loading-skeleton": "3.5.0",
    "react-use": "17.6.1",
    "rxjs": "7.8.2",
    "skinview-utils": "0.7.1",
    "skinview3d": "3.4.2",
    "spectre.css": "0.5.9",
    "use-immer": "0.11.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/bootstrap": "4.6.6",
    "@types/jest": "30.0.0",
    "@types/jquery": "3.5.34",
    "@types/js-yaml": "4.0.9",
    "@types/node": "24.19.2",
    "@types/react": "18.3.31",
    "@types/react-autosuggest": "10.1.11",
    "@types/react-dom": "18.3.7",
    "autoprefixer": "10.7.0",
    "css-loader": "7.1.5",
    "css-minimizer-webpack-plugin": "8.0.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "js-yaml": "4.3.2",
    "mini-css-extract-plugin": "2.10.2",
    "postcss": "8.5.33",
    "postcss-loader": "8.2.2",
    "prettier": "3.10.1",
    "ts-jest": "29.4.15",
    "ts-loader": "9.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "webpack": "5.113.0",
    "webpack-cli": "7.3.1"
  },
  "overrides": {
    "@babel/runtime@7": "7.29.15",
    "@types/three": {
      "fflate": "0.8.3"
    },
    "yaml@1": "1.10.3",
    "ajv@8": "8.20.0",
    "js-yaml@3": "3.15.2",
    "picomatch@2": "2.3.2",
    "glob@>=9 <14.0.2": "14.0.6",
    "minimatch": "11.0.9"
  },
  "browserslist": [
    "> 1%",
    "not dead",
    "not ie 11",
    "Chrome > 52"
  ],
  "prettier": {
    "printWidth": 80,
    "semi": false,
    "singleQuote": true,
    "trailingComma": "all",
    "tabWidth": 2
  },
  "jest": {
    "resetMocks": true,
    "testEnvironment": "jsdom",
    "moduleFileExtensions": [
      "js",
      "ts",
      "tsx",
      "json",
      "node"
    ],
    "moduleNameMapper": {
      "\\.css$": "<rootDir>/resources/assets/tests/__mocks__/style.ts",
      "\\.(png|webp)$": "<rootDir>/resources/assets/tests/__mocks__/file.ts",
      "^@/(.*)$": "<rootDir>/resources/assets/src/$1"
    },
    "setupFilesAfterEnv": [
      "<rootDir>/resources/assets/tests/setup.ts"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/resources/assets/src/styles",
      "<rootDir>/resources/assets/src/scripts/extra.ts",
      "<rootDir>/resources/assets/src/scripts/urls.ts",
      "<rootDir>/resources/assets/tests/setup",
      "<rootDir>/resources/assets/tests/utils"
    ],
    "testMatch": [
      "<rootDir>/resources/assets/tests/**/*.test.ts",
      "<rootDir>/resources/assets/tests/**/*.test.tsx"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/resources/assets/tests/(views|components)/.*\\.ts$"
    ],
    "maxWorkers": "50%",
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/resources/assets/tests/tsconfig.json"
        }
      ]
    }
  },
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": ">=11.19.0 <12"
  },
  "type": "module"
}
