worker_processes 1;
error_log logs/error.log warn;
pid logs/nginx.pid;

events { worker_connections 64; }

http {
    include "@EDGE_ROOT@/conf/mime.types";
    default_type application/octet-stream;
    server_tokens off;
    access_log off;
    client_body_temp_path temp/client-body;
    fastcgi_temp_path temp/fastcgi;

    server {
        listen 127.0.0.1:@HTTPS_PORT@ ssl;
        server_name localhost;
        ssl_certificate "@EDGE_ROOT@/cert.pem";
        ssl_certificate_key "@EDGE_ROOT@/cert-key.pem";
        ssl_protocols TLSv1.2 TLSv1.3;
        client_max_body_size 8m;
        root "@PUBLIC_ROOT@";

        if ($http_host != "localhost:@HTTPS_PORT@") { return 421; }

        location ~* ^/(?:setup|admin/update|plugins|lang|storage)(?:/|$) { return 404; }
        location ~ ^(?!/\.well-known/change-password$).*/\. { return 404; }
        location ~ ^/app/(?:[A-Za-z0-9_-][A-Za-z0-9_.-]*/)*[A-Za-z0-9_-][A-Za-z0-9_.-]*\.(?:js|css|woff2?|ttf|eot|ico|png|webp|svg|wasm|jpe?g|gif|avif)$ {
            add_header X-Content-Type-Options nosniff always;
            try_files $uri =404;
        }
        location ~ ^/app/[A-Za-z0-9_-][A-Za-z0-9_.-]*\.js\.LICENSE\.txt$ { try_files $uri =404; }
        location /app/ { return 404; }

        location / {
            fastcgi_pass 127.0.0.1:@FASTCGI_PORT@;
            fastcgi_read_timeout 100s;
            fastcgi_param SCRIPT_FILENAME "@PUBLIC_ROOT@/index.php";
            fastcgi_param SCRIPT_NAME /index.php;
            fastcgi_param DOCUMENT_ROOT "@PUBLIC_ROOT@";
            fastcgi_param REQUEST_URI $request_uri;
            fastcgi_param QUERY_STRING $query_string;
            fastcgi_param REQUEST_METHOD $request_method;
            fastcgi_param CONTENT_TYPE $content_type;
            fastcgi_param CONTENT_LENGTH $content_length;
            fastcgi_param SERVER_PROTOCOL $server_protocol;
            fastcgi_param SERVER_NAME localhost;
            fastcgi_param SERVER_PORT @HTTPS_PORT@;
            fastcgi_param HTTPS on;
            fastcgi_param REQUEST_SCHEME https;
            fastcgi_param GATEWAY_INTERFACE CGI/1.1;
            fastcgi_param SERVER_SOFTWARE nginx;
            fastcgi_param REMOTE_ADDR $remote_addr;
            fastcgi_param REMOTE_PORT $remote_port;
            fastcgi_param HTTP_PROXY "";
            fastcgi_param HTTP_X_FORWARDED_HOST "";
            fastcgi_param HTTP_X_FORWARDED_PROTO "";
            fastcgi_param HTTP_X_FORWARDED_FOR "";
            fastcgi_param HTTP_X_FORWARDED_PORT "";
            fastcgi_param HTTP_FORWARDED "";
        }
    }
}
