# PHPUnit generates ephemeral application and OAuth keys in its fixture.
APP_ENV=testing
APP_DEBUG=false
APP_URL=http://localhost
APP_TRUSTED_PROXIES=
LOCALE=en
DB_CONNECTION=sqlite
DB_DATABASE=:memory:
DB_PREFIX=
MAIL_MAILER=array
CACHE_DRIVER=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
LOG_CHANNEL="null"
LOG_DEPRECATIONS_CHANNEL="null"
