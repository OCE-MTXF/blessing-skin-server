# Template only. Supply instance-specific values through a protected deployment
# environment or a private .env outside public/. Never copy secrets into the image/ZIP.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://skin.example.test
APP_FALLBACK_LOCALE=en
# Leave blank with direct TLS. Otherwise use explicit trusted proxy IPs/CIDRs only.
APP_TRUSTED_PROXIES=
APP_KEY=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=blessingskin
DB_USERNAME=blessing
DB_PASSWORD=
DB_PREFIX=
# For an isolated, dedicated local SQLite file instead: DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/private/path/blessing.sqlite

# New passwords use Argon2id. Set PWD_METHOD only to match an adopted 6.0.2 database.
# PWD_METHOD=BCRYPT
# Mount protected OAuth keys as oauth-private.key and oauth-public.key under
# LARAVEL_STORAGE_PATH. On POSIX both must be readable by PHP and have mode
# 0400, 0440, 0600, or 0640. Mount them read-only; do not use 0644 or 0660.
# Alternatively supply PEM contents (not file paths) through protected variables:
# PASSPORT_PRIVATE_KEY=
# PASSPORT_PUBLIC_KEY=
# Set LARAVEL_STORAGE_PATH=/absolute/private/state in the real process
# environment (FPM pool, CLI and worker), not just in this private .env file.
# TEXTURES_DIR=/absolute/private/state/textures
FS_DRIVER=local

CACHE_DRIVER=file
SESSION_DRIVER=file
# Production recovery must run off the HTTP request in a monitored worker.
QUEUE_CONNECTION=database
LOG_CHANNEL=daily
LOG_LEVEL=warning
# Use your trusted SMTP relay with certificate verification. Port 465 selects SMTPS.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

# Plugins are disabled by default; see the deployment/plugin policy before enabling.
PLUGINS_DIR=
PLUGINS_APPROVALS_FILE=
PLUGINS_APPROVALS_SHA256=
PLUGINS_CATALOG_FILE=
